<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/tv_background" android:orientation="vertical" android:paddingStart="@dimen/tv_page_padding" android:paddingEnd="@dimen/tv_page_padding" android:paddingTop="12mm" android:clipChildren="false" android:clipToPadding="false">
    <com.github.tvbox.osc.ui.compose.TvHeroView android:id="@+id/tvHomeHero" android:layout_width="match_parent" android:layout_height="292mm" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="52mm" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/tvContinueTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/tv_continue_watching" android:textColor="@color/tv_text_primary" android:textSize="22mm" android:textStyle="bold" />
        <LinearLayout android:id="@+id/tvPush" android:layout_width="80mm" android:layout_height="36mm" android:layout_marginEnd="12mm" android:background="@drawable/tv_pill_selector" android:gravity="center" android:focusable="true" android:clickable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tv_push" android:textColor="@color/tv_text_secondary" android:textSize="16mm" />
        </LinearLayout>
        <LinearLayout android:id="@+id/tvHistory" android:layout_width="100mm" android:layout_height="36mm" android:background="@drawable/tv_pill_selector" android:gravity="center" android:focusable="true" android:clickable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="全部记录 ›" android:textColor="@color/tv_text_secondary" android:textSize="16mm" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/tvHistoryEmpty" android:layout_width="match_parent" android:layout_height="38mm" android:gravity="center_vertical" android:text="@string/tv_no_history" android:textColor="@color/tv_text_secondary" android:textSize="18mm" />
    <com.owen.tvrecyclerview.widget.TvRecyclerView android:id="@+id/tvHotList" android:layout_width="match_parent" android:layout_height="205mm" android:clipChildren="false" android:clipToPadding="false" app:tv_horizontalSpacingWithMargins="16mm" app:tv_selectedItemIsCentered="true" />
    <LinearLayout android:id="@+id/tvUserHome" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone">
        <LinearLayout android:id="@+id/tvLive" android:layout_width="0dp" android:layout_height="0dp" />
        <LinearLayout android:id="@+id/tvSearch" android:layout_width="0dp" android:layout_height="0dp" />
        <LinearLayout android:id="@+id/tvSetting" android:layout_width="0dp" android:layout_height="0dp" />
        <LinearLayout android:id="@+id/tvFavorite" android:layout_width="0dp" android:layout_height="0dp" />
    </LinearLayout>
</LinearLayout>
