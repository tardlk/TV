<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tvNavigation"
    android:layout_width="match_parent"
    android:layout_height="@dimen/tv_header_height"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/tv_page_padding"
    android:paddingEnd="@dimen/tv_page_padding">
    <TextView
        android:layout_width="82mm"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/tv_text_primary"
        android:textSize="32mm"
        android:textStyle="bold"/>
    <TextView
        android:id="@+id/tvNavHome"
        style="@style/TvNavigation"
        android:text="@string/tv_home"/>
    <TextView
        android:id="@+id/tvNavLive"
        style="@style/TvNavigation"
        android:text="@string/tv_live"/>
    <TextView
        android:id="@+id/tvNavHistory"
        style="@style/TvNavigation"
        android:text="@string/tv_history"/>
    <TextView
        android:id="@+id/tvNavCollection"
        style="@style/TvNavigation"
        android:text="@string/tv_collection"/>
    <TextView
        android:id="@+id/tvNavSettings"
        style="@style/TvNavigation"
        android:text="@string/tv_settings"/>
    <Space
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1"/>
    <TextView
        android:id="@+id/tvNavSource"
        android:layout_width="200mm"
        android:layout_height="44mm"
        android:layout_marginEnd="12mm"
        android:background="@drawable/tv_pill_selector"
        android:ellipsize="end"
        android:singleLine="true"
        android:gravity="center"
        android:paddingStart="12mm"
        android:paddingEnd="12mm"
        android:text="@string/tv_add_config"
        android:textColor="@color/tv_text_primary"
        android:textSize="18mm"
        android:focusable="true"
        android:clickable="true"/>
    <TextView
        android:id="@+id/tvNavSearch"
        style="@style/TvNavigation"
        android:layout_width="68mm"
        android:text="@string/tv_search"/>
    <TextView
        android:id="@+id/tvDate"
        android:layout_width="65mm"
        android:layout_height="44mm"
        android:gravity="center"
        android:textColor="@color/tv_text_primary"
        android:textSize="20mm"/>
</LinearLayout>
