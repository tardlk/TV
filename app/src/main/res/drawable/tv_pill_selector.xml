<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape><solid android:color="@color/tv_selected"/><corners android:radius="100dp"/><stroke android:width="2dp" android:color="@color/tv_outline"/></shape></item>
    <item android:state_selected="true"><shape><solid android:color="@color/tv_selected"/><corners android:radius="100dp"/></shape></item>
    <item android:state_activated="true"><shape><solid android:color="@color/tv_selected"/><corners android:radius="100dp"/></shape></item>
    <item><shape><solid android:color="@color/tv_surface"/><corners android:radius="100dp"/></shape></item>
</selector>
